<script nonce="<%=locals.nonce%>">
(function() {
  var d = document;
  function signedIn() {
    var m = d.cookie.match(/(?:^|;\s*)C=([^;]*)/);
    return !!(m && /(?:^|&)hu=1(?:&|$)/.test(m[1]));
  }
  // Case A (not signed in): leave the modal exactly as server-rendered.
  if (!signedIn()) {
    return;
  }
  var form = d.getElementById('f2');
  if (!form || form.dataset.action !== 'shabbat-weekly') {
    return;
  }
  var modal = d.getElementById('email-modal');
  var google = d.getElementById('emc-google');
  var subscribeMe = d.getElementById('emc-subscribe-me');
  var subscribeMeBtn = subscribeMe && subscribeMe.querySelector('button');
  var updateBox = d.getElementById('emc-update');
  var updateLink = d.getElementById('emc-update-link');
  var divider = d.getElementById('emc-divider');
  var emailField = d.getElementById('emc-email-field');
  var meLabel = d.getElementById('emc-me-label');
  var bottomBtn = d.getElementById('email-subscribe');
  var entry = d.getElementById('email-modal-entry');
  var verified = d.getElementById('email-modal-verified');
  var failure = d.getElementById('email-modal-failure');
  var ready = false;
  var hasActiveSub = false;
  var userEmail = null;

  function locationParams() {
    var p = '';
    ['geonameid', 'zip'].forEach(function(k) {
      var el = form.querySelector('[name="' + k + '"]');
      if (el && el.value) {
        p += '&' + k + '=' + encodeURIComponent(el.value);
      }
    });
    return p;
  }

  // A signed-in user never sees "Sign in with Google". With an active
  // subscription they see ONLY "Update Settings" (carrying this page's city so
  // they can switch to it); otherwise ONLY "Subscribe <email>". Never both.
  function apply() {
    if (!ready) {
      return;
    }
    if (google) google.hidden = true;
    if (hasActiveSub) {
      if (updateLink) {
        updateLink.href = '/email?e=' + encodeURIComponent(btoa(userEmail)) + locationParams();
      }
      if (updateBox) updateBox.hidden = false;
      if (subscribeMe) subscribeMe.hidden = true;
      if (divider) divider.hidden = true;
      if (emailField) emailField.hidden = true;
      if (bottomBtn) bottomBtn.style.display = 'none';
    } else {
      if (meLabel) meLabel.textContent = userEmail;
      if (subscribeMe) subscribeMe.hidden = false;
      if (updateBox) updateBox.hidden = true;
      if (divider) {
        divider.hidden = false;
        divider.textContent = 'or subscribe with a different email address';
      }
      if (emailField) emailField.hidden = false;
      if (bottomBtn) {
        bottomBtn.style.display = '';
        bottomBtn.classList.remove('btn-primary');
        bottomBtn.classList.add('btn-secondary');
      }
    }
  }

  // The bundle's show.bs.modal handler resets the entry, so re-apply after it.
  if (modal) {
    modal.addEventListener('show.bs.modal', function() {
      setTimeout(function() {
        if (verified) verified.style.display = 'none';
        apply();
      }, 0);
    });
  }

  var qs = new URLSearchParams();
  ['geo', 'zip', 'geonameid'].forEach(function(k) {
    var el = form.querySelector('[name="' + k + '"]');
    if (el && el.value) {
      qs.append(k, el.value);
    }
  });
  fetch('/email/subscription-status?' + qs.toString(),
      {credentials: 'include', headers: {'Accept': 'application/json'}})
      .then(function(r) {
        return r.ok ? r.json() : null;
      })
      .then(function(data) {
        if (!data || !data.loggedIn || !data.email) {
          return; // stale hint cookie: leave the default (Case A)
        }
        userEmail = data.email;
        hasActiveSub = !!data.hasActiveSub;
        ready = true;
        apply();
      })
      .catch(function() {});

  // Blue "Subscribe <email>" -> activate immediately for the signed-in user.
  if (subscribeMeBtn) {
    subscribeMeBtn.addEventListener('click', function() {
      if (!userEmail) {
        return;
      }
      if (failure) failure.style.display = 'none';
      subscribeMeBtn.disabled = true;
      subscribeMeBtn.textContent = 'Processing...';
      var params = new URLSearchParams(new FormData(form));
      params.set('em', userEmail);
      var opts = {
        method: 'POST', credentials: 'include', body: params,
        headers: {'Accept': 'application/json'},
      };
      if (typeof AbortSignal === 'function') {
        opts.signal = AbortSignal.timeout(9000);
      }
      function fail() {
        subscribeMeBtn.disabled = false;
        subscribeMeBtn.textContent = 'Subscribe ' + userEmail;
        if (failure) failure.style.display = 'block';
      }
      fetch('/email/', opts)
          .then(function(r) {
            return r.ok ? r.json() : null;
          })
          .then(function(data) {
            if (data && data.ok) {
              if (entry) entry.style.display = 'none';
              if (bottomBtn) bottomBtn.style.display = 'none';
              if (verified) verified.style.display = 'block';
            } else {
              fail();
            }
          })
          .catch(fail);
    });
  }
})();
</script>
