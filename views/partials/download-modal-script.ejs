<script type="application/json" id="dlURLs">
<%- locals.jsonForScript(locals.makeDlUrlsForScript(locals.url)) %>
</script>
<script nonce="<%=locals.nonce%>">
document.addEventListener('DOMContentLoaded', function() {
  const dlURLs = JSON.parse(document.getElementById('dlURLs').textContent);
  let calColor = '';
  let emojiChecked = true;
  let yahrzeitReminderChecked = true;
  function dlUrl(srcType) {
    const key = srcType === 'webcal' || srcType === 'gcal' || srcType === 'olcom' ?
      'subical' : srcType;
    const path = dlURLs[key];
    if (typeof path !== 'string') {
      return null;
    }
    const isApi = key === 'pdf' || key === 'csv_usa' || key === 'csv_eur';
    return new URL(path, isApi ? dlURLs.apiHost : dlURLs.host);
  }
  function makeHref(srcType, url) {
    const href = url.href;
    if (srcType === 'webcal') {
      return href.replace(/^https?/, 'webcal');
    } else if (srcType === 'gcal') {
      return 'https://www.google.com/calendar/render?cid=' +
        encodeURIComponent(href.replace(/^https/, 'http'));
    } else if (srcType === 'olcom') {
      return 'https://outlook.live.com/calendar/addfromweb?url=' +
        encodeURIComponent(href.replace(/^https/, 'http')) +
        '&name=' + encodeURIComponent(dlURLs.title) + '&mkt=en-001';
    }
    return href;
  }
  function setTarget(el, url) {
    if (url) {
      el[el.dataset.hebcalAttr] = makeHref(el.dataset.hebcalSrc, url);
    }
  }
  document.querySelectorAll('[data-hebcal-src]').forEach(function(el) {
    setTarget(el, dlUrl(el.dataset.hebcalSrc));
  });
  function applyOptions(url, id) {
    if (!emojiChecked) {
      url.searchParams.set('emoji', '0');
    }
    if (calColor && id === 'dl-ios') {
      url.searchParams.set('color', calColor);
    }
    if (!yahrzeitReminderChecked) {
      url.searchParams.set('yrem', '0');
    }
    return url;
  }
  function changeButtonTarget(id) {
    const btn = document.getElementById(id);
    setTarget(btn, applyOptions(dlUrl(btn.dataset.hebcalSrc), id));
    const btn2 = document.getElementById(id + '-alt');
    if (btn2) {
      setTarget(btn2, applyOptions(dlUrl('ics1year'), id + '-alt'));
    }
  }
  const ccEl = document.getElementById('cal-color');
  if (ccEl) {
    ccEl.addEventListener('change', function(event) {
      calColor = event.target.value;
      changeButtonTarget('dl-ios');
    }, false);
  }
  document.querySelectorAll('.emoji-checkbox .form-check-input').forEach(function(el) {
    const inputId = el.id.substring(2);
    el.addEventListener('change', function(event) {
      emojiChecked = event.target.checked;
      changeButtonTarget(inputId);
    }, false);
  });
  document.querySelectorAll('.reminder-checkbox .form-check-input').forEach(function(el) {
    const inputId = el.id.substring(4);
    el.addEventListener('change', function(event) {
      yahrzeitReminderChecked = event.target.checked;
      changeButtonTarget(inputId);
    }, false);
  });
});
</script>
