<script nonce="<%=locals.nonce%>">
(function() {
  var d = document;
  var m = d.cookie.match(/(?:^|;\s*)C=([^;]*)/);
  // Case A (not signed in): leave the modal exactly as server-rendered.
  if (!(m && /(?:^|&)hu=1(?:&|$)/.test(m[1]))) {
    return;
  }
  var form = d.getElementById('f2');
  if (!form || (form.dataset.action || '').indexOf('yahrzeit') !== 0) {
    return;
  }
  var ulidEl = form.querySelector('[name="ulid"]');
  var ulid = ulidEl && ulidEl.value;
  if (!ulid) {
    return;
  }
  fetch('/yahrzeit/email-status?ulid=' + encodeURIComponent(ulid),
      {credentials: 'include', headers: {'Accept': 'application/json'}})
      .then(function(r) {
        return r.ok ? r.json() : null;
      })
      .then(function(data) {
        // Only change the modal when the signed-in user ALREADY has an active
        // reminder subscription (with their own email) for this calendar: hide
        // the redundant Google button, show a confirmation, and reframe the
        // email entry as adding another address.
        if (!data || !data.loggedIn || !data.email || !data.subscribedToThisCalendar) {
          return;
        }
        var google = d.getElementById('ye-google');
        if (google) google.hidden = true;
        var emailSpan = d.getElementById('ye-active-email');
        if (emailSpan) emailSpan.textContent = data.email;
        var active = d.getElementById('ye-active');
        if (active) active.hidden = false;
        var divider = d.getElementById('ye-divider');
        if (divider) divider.textContent = 'subscribe another email address to this calendar';
      })
      .catch(function() {});
})();
</script>
