<%- await include('partials/header-and-navbar.ejs') -%>
<div class="row mt-3">
<div class="col-md-6 offset-md-3">
<h2 class="mb-3">Sign in to Hebcal</h2>
<p class="lead">Sign in to save your settings and manage your Yahrzeit and
email subscriptions.</p>
<% if (locals.googleLoginEnabled) { %>
<div class="d-grid gap-2 col-8 mx-auto my-4">
<%- await include('partials/google-signin-button.ejs', {next: locals.next, btnBlock: true}) -%>
</div><!-- .d-grid -->
<% } else { %>
<div class="alert alert-warning" role="alert">
Sign-in is not available on this server yet.
</div><!-- .alert -->
<% } %>
<p class="text-muted small mt-4">By signing in you agree to our
<a href="/home/about/privacy-policy">Privacy Policy</a>. We only use your
name and email address to identify your account.</p>
</div><!-- .col -->
</div><!-- .row -->
<%- await include('partials/footer.ejs') -%>
