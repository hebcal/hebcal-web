<%- await include('partials/header.ejs', {
  title: `${locals.cfg.shortName} - Daily Learning Calendar - Hebcal`,
}) -%>
<link rel="canonical" href="https://www.hebcal.com/learning/<%=locals.slug%><%=locals.il?'?i=on':''%>">
<% if (locals.desc) { %><meta name="description" content="<%=locals.desc%>"><% } %>
<%- await include('partials/style-fullcalendar.ejs') -%>
<style>
.fc * a {
  color: inherit;
  text-decoration: none;
}
.fc-daygrid-block-event .fc-event-time, .fc-daygrid-block-event .fc-event-title {
  padding: 2px 6px 2px 2px;
}
.fc-hdate {
  font-size: 0.75em;
  white-space: nowrap;
  margin-left: 0.25rem;
  margin-right: 1rem;
  --bs-text-opacity: 1;
  color: rgba(var(--bs-secondary-rgb),1);
}
/* must match FullCalendar's own `.fc .fc-daygrid-day-events {margin-top:1px}`;
   it injects its <style> ahead of ours, so equal specificity is enough */
.fc .fc-daygrid-day-events {
  margin-top: 0.5rem;
}
</style>
</head>
<body>
<%- await include('partials/navbar.ejs') -%>
<div class="container">
<div class="row mt-2">
<div class="col">
<h1><%= locals.cfg.shortName %></h1>
<% if (locals.desc) { %><p class="lead"><%= locals.desc %></p><% } %>
<div id="calendar" data-schedule="<%=locals.schedule%>" data-color="<%=locals.cfg.color%>"></div>
</div><!-- .col -->
</div><!-- .row -->
<%- await include('partials/download-modal.ejs') -%>
<script nonce="<%=locals.nonce%>">
document.addEventListener('DOMContentLoaded', function() {
<%- await include('partials/client-daily-learning.min.js') %>
});
</script>
<%- await include('partials/footer.ejs', {footerScripts: {clipboard: true}}) _%>
