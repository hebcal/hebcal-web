<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hebcal REST APIs &mdash; OpenAPI / Scalar</title>
<meta name="description" content="Interactive OpenAPI documentation for the Hebcal Jewish Calendar, Hebrew Date Converter, Zmanim (including Assur Melacha), Leyning, and Yahrzeit REST APIs.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style>
  html, body { margin: 0; }
</style>
</head>
<body>
<div id="app"></div>
<script defer nonce="<%=locals.nonce%>" src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.76.4/dist/browser/standalone.js" crossorigin="anonymous"></script>
<script nonce="<%=locals.nonce%>">
// withDefaultFonts:false keeps Scalar from loading fonts.scalar.com, which the
// site's font-src CSP does not allow; it falls back to the system font stack.
document.addEventListener('DOMContentLoaded', function() {
  Scalar.createApiReference('#app', {
    url: '/api-docs/openapi.json',
    withDefaultFonts: false,
    showDeveloperTools: 'never',
    agent: {disabled: true},
    telemetry: false
  });
});
</script>
</body>
</html>
