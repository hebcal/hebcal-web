<%- await include('partials/header-and-navbar.ejs') -%>
<div class="row mt-3">
<div class="col-md-8 offset-md-2">
<h2 class="mb-3">Your Account</h2>
<table class="table">
<tbody>
<% if (locals.user.displayName) { %>
<tr><th scope="row">Name</th><td><%= locals.user.displayName %></td></tr>
<% } %>
<tr><th scope="row">Email</th><td><%= locals.user.email %></td></tr>
</tbody>
</table>

<h3 class="mt-4">Shabbat candle-lighting email</h3>
<% if (locals.shabbat && locals.shabbat.status === 'active') { %>
<p>You are subscribed to weekly Shabbat candle-lighting times<% if (locals.shabbat.locationName) { %>
for <strong><%= locals.shabbat.locationName %></strong><% } %>.</p>
<p><a class="btn btn-outline-primary btn-sm" href="<%= locals.shabbat.manageUrl %>">Manage subscription</a></p>
<% } else if (locals.shabbat && locals.shabbat.status === 'pending') { %>
<p>Your Shabbat email subscription is <strong>pending confirmation</strong>. Please
check your email for the confirmation link, or
<a href="<%= locals.shabbat.manageUrl %>">re-send it</a>.</p>
<% } else { %>
<p>You are not subscribed.
<a href="/email">Subscribe to weekly Shabbat candle-lighting times</a>.</p>
<% } %>

<h3 class="mt-4">Yahrzeit + Anniversary reminders</h3>
<% if (locals.yahrzeit && locals.yahrzeit.length) { %>
<ul class="list-group mb-3">
<% for (const cal of locals.yahrzeit) { %>
<li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
<a href="/yahrzeit/edit/<%= cal.calendarId %>"><%= cal.title %></a>
<span class="text-muted small">updated <%= locals.formatMonthYear(cal.updated) %></span>
</li>
<% } %>
</ul>
<p><a class="btn btn-outline-primary btn-sm" href="/yahrzeit/new">Create another calendar</a></p>
<% } else { %>
<p>You have no active reminders.
<a href="/yahrzeit/new">Create a Yahrzeit or Anniversary calendar</a>.</p>
<% } %>

<form method="post" action="/logout" class="mt-4">
<button type="submit" class="btn btn-outline-secondary">
<svg class="icon icon-sm mt-n1 me-1"><use href="<%=locals.spriteHref%>#bi-box-arrow-right"></use></svg>
Sign out
</button>
</form>
</div><!-- .col -->
</div><!-- .row -->
<%- await include('partials/footer.ejs') -%>
