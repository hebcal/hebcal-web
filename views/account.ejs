<%- await include('partials/header-and-navbar.ejs') -%>
<div class="row mt-3">
<div class="col-md-8 offset-md-2">
<h2 class="mb-3">Your Account</h2>
<table class="table">
<tbody>
<% if (locals.user.displayName) { %>
<tr><th scope="row">Name</th><td><%= locals.user.displayName %></td></tr>
<% } %>
<tr><th scope="row">Email</th><td><%= locals.user.email %></td></tr>
</tbody>
</table>

<form method="post" action="/logout" class="mt-4">
<button type="submit" class="btn btn-secondary">
<svg class="icon icon-sm mt-n1 me-1"><use href="<%=locals.spriteHref%>#bi-box-arrow-right"></use></svg>
Sign out
</button>
</form>

<h5 class="mt-4"><svg class="icon mb-1 me-1 text-body-secondary" fill="currentColor">
 <use href="<%=locals.spriteHref%>#gi-candle"></use></svg>
 Shabbat candle-lighting times</h5>
<% if (locals.shabbat && locals.shabbat.status === 'active') { %>
<p>You are subscribed to weekly emails<% if (locals.shabbat.locationName) { %>
for <strong><%= locals.shabbat.locationName %></strong><% } %>.</p>
<p><a class="btn btn-primary btn-sm" href="<%= locals.shabbat.manageUrl %>">Manage subscription &raquo;</a></p>
<% } else if (locals.shabbat && locals.shabbat.status === 'pending') { %>
<p>Your Shabbat email subscription is <strong>pending confirmation</strong>. Please
check your email for the confirmation link, or
<a href="<%= locals.shabbat.manageUrl %>">re-send it</a>.</p>
<% } else { %>
<p>No subscription found.<br>
<a href="/email">Subscribe</a> to weekly Shabbat candle-lighting times
and Torah portion by email</p>
<% } %>

<h5 class="mt-4"><svg class="icon mb-1 me-1 text-body-secondary" fill="currentColor">
 <use href="<%=locals.spriteHref%>#gi-user-parents"></use></svg>
 Yahrzeit + Anniversary Calendars</h5>
<% if (locals.yahrzeit && locals.yahrzeit.length) { %>
<table class="table">
<tbody>
<% for (const cal of locals.yahrzeit) { %>
<tr>
<td><a href="/yahrzeit/edit/<%= cal.calendarId %>"><%= cal.title %></a></td>
<td><span class="text-muted small">updated <%= locals.formatMonthYear(cal.updated) %>
&middot; <a href="/yahrzeit/email?id=<%= cal.subId %>&amp;num=all&amp;unsubscribe=1&amp;cfg=html">unsubscribe</a></span></td>
</tr>
<% } %>
</tbody>
</table>
<% } else { %>
<p>You have no active reminders.
<% } %>
<p><a class="btn btn-primary btn-sm" href="/yahrzeit/new">New calendar &raquo;</a></p>

</div><!-- .col -->
</div><!-- .row -->
<%- await include('partials/footer.ejs') -%>
